{
  "name": "friday",
  "version": "0.0.1",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "SAGAR TAMANG",
  "homepage": "http://friday.feynmanpi.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAGAR-TAMANG/friday.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux",
    "postinstall": "node scripts/postinstall.mjs",
    "lint": "eslint --cache .",
    "test": "node --experimental-strip-types --test src/main/cognition/*.test.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/generative-ai": "^0.24.1",
    "@nut-tree-fork/libnut-darwin": "^2.7.5",
    "@nut-tree-fork/libnut-linux": "^2.7.5",
    "@nut-tree-fork/libnut-win32": "^2.7.5",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@openai/agents": "^0.2.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^6.0.196",
    "bindings": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "fast-deep-equal": "^3.1.3",
    "fast-uri": "^3.1.0",
    "file-uri-to-path": "^1.0.0",
    "json-schema-traverse": "^1.0.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "ms": "^2.1.3",
    "openai": "^6.44.0",
    "radix-ui": "^1.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "require-from-string": "^2.0.2",
    "shadcn": "^4.10.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uiohook-napi": "^1.5.4",
    "use-stick-to-bottom": "^1.1.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
